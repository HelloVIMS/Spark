# Model spec for `systemctl --user start vllm-model@qwen35b-nvfp4`.
# Consumed via EnvironmentFile; keep values shell-safe.
VLLM_NAME=qwen35b-nvfp4
VLLM_MODEL=Qwen3.6-35B-A3B-NVFP4
VLLM_PORT=8000
VLLM_GPU_MEM_UTIL=0.70
VLLM_EXTRA_ARGS=--quantization compressed-tensors --dtype bfloat16 --max-model-len 65536 --kv-cache-dtype=fp8_e4m3 --disable-custom-all-reduce
